{
    "name": "mirotalksfu",
    "version": "2.4.71",
    "description": "WebRTC SFU browser-based video calls",
    "main": "Server.js",
    "scripts": {
        "test": "mocha tests/*.js",
        "start": "node app/src/Server.js",
        "start-dev": "nodemon app/src/Server.js",
        "debug": "DEBUG='mediasoup*' node app/src/Server.js",
        "build:mediasoup-client": "npx esbuild node_modules/mediasoup-client/lib/index.js --bundle --minify --format=iife --global-name=mediasoupClient --outfile=public/sfu/MediasoupClient.js --platform=browser",
        "postinstall": "npm run build:mediasoup-client",
        "lint": "node scripts/lint.mjs",
        "check:syntax": "node scripts/check-source.mjs",
        "test:bodrik": "node scripts/test-bodrik.mjs",
        "test:music-integration": "node scripts/test-bodrik.mjs --music-integration",
        "format:check": "node scripts/format.mjs check",
        "format:write": "node scripts/format.mjs write",
        "docker:build": "docker build --tag mirotalk/sfu:latest .",
        "docker:rmi": "docker image prune -f",
        "docker:push": "docker push mirotalk/sfu:latest",
        "docker:pull": "docker pull mirotalk/sfu:latest",
        "docker:rmc": "docker container rm mirotalksfu --force",
        "docker:run": "docker run -d -p 40000-40100:40000-40100 -p 3010:3010 -v ./.env:/src/.env -v ./app/src/config.js:/src/app/src/config.js:ro --name mirotalksfu mirotalk/sfu:latest",
        "docker:run-vm": "docker run -d -p 40000-40100:40000-40100 -p 3010:3010 -v ./.env:/src/.env -v ./app/:/src/app/:ro -v ./public/:/src/public/:ro --name mirotalksfu mirotalk/sfu:latest",
        "docker:start": "docker start mirotalksfu",
        "docker:stop": "docker stop mirotalksfu"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/miroslavpejic85/mirotalksfu"
    },
    "keywords": [
        "webrtc",
        "socket.io",
        "broadcasting",
        "sfu",
        "nodejs",
        "video",
        "audio",
        "rtmp",
        "poll",
        "client",
        "server",
        "streaming",
        "realtime"
    ],
    "author": "Miroslav Pejic",
    "license": "AGPL-3.0",
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "chokidar": "^5.0.0",
        "colors": "1.4.0",
        "compression": "1.8.2",
        "cors": "2.8.6",
        "crypto-js": "4.2.0",
        "dompurify": "^3.4.15",
        "dotenv": "^18.0.1",
        "express": "5.2.1",
        "express-rate-limit": "^8.7.0",
        "he": "^1.2.0",
        "helmet": "^8.3.0",
        "httpolyglot": "0.1.2",
        "jsdom": "^30.1.0",
        "jsonwebtoken": "^9.0.3",
        "mediasoup": "^3.27.1",
        "mediasoup-client": "3.23.2",
        "socket.io": "4.8.3",
        "uuid": "14.0.2"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "eslint": "^9.39.2",
        "mocha": "^12.0.2",
        "nodemon": "^3.1.14",
        "prettier": "3.9.8",
        "proxyquire": "^2.1.3",
        "should": "^13.2.3",
        "sinon": "^22.1.0"
    }
}
